{
  "name": "@deepseek-ai/dsh-prompt-control-web-profile",
  "description": "Private Web profile layer for Prompt Control",
  "version": "0.1.3-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/prompt/prompt-control-web-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/dsh-prompt-control": "workspace:^",
    "@deepseek-ai/dsh-prompt-control-ui": "workspace:^"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
